# Copy to corp-probe.env (gitignored) and fill with real values for LLM-S23.
#   set -a && source local-dev/corp-probe.env && set +a
#   ./local-dev/probe-gateway.sh
#   ./local-dev/merge-probe-into-matrix.sh

PROBE_LABEL=corp
UPSTREAM_BASE_URL=https://llm-gateway.example.com/v1
UPSTREAM_API_KEY=
MODEL_ID=databricks/gdp-gpt4o
# 0 = disable TLS verify only for probe curl (prefer corp CA instead)
UPSTREAM_VERIFY_TLS=1
# Optional: SSL_CERT_FILE=/path/to/corp-ca-bundle.pem
